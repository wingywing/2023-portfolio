{#
    Decorative pastel shapes that drift behind the page content.
    Only three primitives are used: squares, circles and equilateral triangles.
    Purely ornamental: hidden from assistive tech and never interactive.
#}
<div class="ambient-shapes" aria-hidden="true">
    <span class="ambient-shape ambient-shape--circle ambient-shape--1"></span>
    <span class="ambient-shape ambient-shape--square ambient-shape--2"></span>
    <span class="ambient-shape ambient-shape--triangle ambient-shape--3"></span>
    <span class="ambient-shape ambient-shape--square ambient-shape--4"></span>
    <span class="ambient-shape ambient-shape--triangle ambient-shape--5"></span>
    <span class="ambient-shape ambient-shape--circle ambient-shape--6"></span>
    <span class="ambient-shape ambient-shape--square ambient-shape--7"></span>
    <span class="ambient-shape ambient-shape--circle ambient-shape--8"></span>
</div>
