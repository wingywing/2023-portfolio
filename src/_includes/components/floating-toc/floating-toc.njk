<div id="floating-toc"{% if tocchildren == false %} data-toc-children="false"{% endif %}>
    <h1>Contents</h1>
    <div class="floating-toc-content">
    </div>
</div>

<script>
    let toc = $('#contents');
    $('h2').each(function(){
        contents = toc.nextUntil('h2').clone();
    }) //wrap existing ToC into a div called ToC
    tocDiv = $('<div class="toc" />');
    tocDiv.insertAfter(toc);
    tocDiv.html(contents);

    let floatingTocContent = $('#floating-toc');
    $('.floating-toc-content').html(contents); //Inject the new floating-toc component with content from the main body

    //The list has been copied into the sidebar, so hide the original. Tagging
    //it here rather than guessing at it in CSS keeps this working whatever
    //markup a given case study puts after its Contents heading.
    toc.add(toc.nextUntil('h2')).addClass('toc-source');

    function setSelectedTocItem() { //set selected floating ToC item based on URL slug by matching the href in floating toc items
        let urlString = $(location).attr('href');
        urlArray = urlString.split("/");
        urlSlug = urlArray.pop();
        $(".floating-toc-content li a").each(function(){
            if ($(this).attr("href") == urlSlug){
                $(this).addClass("selected");
            } else {
                $(this).removeClass("selected");
            }
        })
    }
    setSelectedTocItem();
    $(window).on('hashchange', function(e){
        setSelectedTocItem();
    }); //change the ToC active item when the url hash changes

    //Jumping to a section shouldn't be a place the reader can go "back" to.
    //A plain anchor pushes a history entry per click, so after reading down a
    //case study the back button walks up the sections it visited instead of
    //returning to wherever the reader came from. Scroll it ourselves and
    //replace the entry rather than adding one.
    $('#floating-toc').on('click', 'a[href^="#"]', function (event) {
        const id = decodeURIComponent(this.getAttribute('href').slice(1));
        const target = document.getElementById(id);
        if (!target) {
            return; //let the browser deal with it
        }
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        //Move focus with the scroll, so keyboard and screen reader users land
        //on the section rather than staying in the sidebar.
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        history.replaceState(null, '', '#' + id);
        setSelectedTocItem();
    });

    //Update the url hash to match content that user is up to.
    //This uses replaceState, not pushState: pushState added a history entry for
    //every section scrolled past, so Back walked up the page section by section
    //instead of returning to the page the reader actually came from.
    let currentHash = null;
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (!entry.isIntersecting) {
                return; //ignore headings scrolling out of view
            }
            const newHash = entry.target.id;
            if (!newHash || newHash === currentHash) {
                return; //nothing to sync
            }
            currentHash = newHash;
            history.replaceState(null, "", "#" + newHash);
            setSelectedTocItem(); //call function to update floating ToC
        })
    }, {
        rootMargin: "0px 0px -50% 0px", //Only change hash to new section when it's halfway on the screen
    });
    //Watch when a heading is in intersection, e.g. h2, h3...
    //Watch when user scrolls down
    const sectionHeadings = document.querySelectorAll("h2, h3, h4");
    sectionHeadings.forEach( sectionHeading => {
            observer.observe(sectionHeading)
        }
    )
</script>
