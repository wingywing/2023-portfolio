{#
    Filter panel for the case study grid.
    Pass through:
    - groups --> the caseStudyFilters data (an array of { id, label, options })
    - total  --> how many items the grid holds, for the initial status line

    Icons are the pixel paths from the filter design, kept inline so they
    inherit currentColor and stay crisp alongside the rest of the pixel art.

    Progressive enhancement: the panel ships hidden and the script reveals it,
    so with JS off every case study stays visible instead of being filtered
    into nothing.
#}
<form class="filter-panel" data-filter-panel hidden>
    <div class="filter-panel__header">
        <h3 class="filter-panel__title">Filters</h3>
        <svg class="filter-panel__mark" viewBox="0 0 18.67 10.67" aria-hidden="true" focusable="false" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.666 0H0v2.667h2.666v2.666h2.667V8h2.667v2.667h2.666V8h2.667V5.333h2.667V2.667H18.666V0h-2.667v2.667h-2.667v2.666h-2.666V8H8V5.333H5.333V2.667H2.666V0Z"/>
        </svg>
    </div>

    <div class="filter-panel__search">
        <label class="visually-hidden" for="case-study-search">Search case studies</label>
        <input type="search" id="case-study-search" data-filter-search
               placeholder="Search" autocomplete="off">
        <svg class="filter-panel__search-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 0h8v2H4V0ZM2 4V2h2v2H2ZM2 12H0V4h2v8ZM4 14H2v-2h2v2ZM12 14v2H4v-2h8ZM14 12h-2v2h2v2h2v2h2v2h2v-2h-2v-2h-2v-2h-2v-2ZM14 4h2v8h-2V4ZM14 4V2h-2v2h2Z"/>
        </svg>
    </div>

    {% for group in params.groups %}
    <fieldset class="filter-group">
        <legend class="filter-group__legend">{{ group.label }}</legend>
        <ul class="filter-group__options">
            {% for option in group.options %}
            <li>
                <label class="filter-option">
                    <input type="checkbox" class="visually-hidden"
                           name="{{ group.id }}" value="{{ option.value }}"
                           data-filter-group="{{ group.id }}">
                    <svg class="filter-option__box" viewBox="0 0 18 18" aria-hidden="true" focusable="false" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path class="filter-option__box-off" d="M0 0h18v18H0V0Zm16 16V2H2v14h14Z"/>
                        <path class="filter-option__box-on" d="M2 0H0v18h18V0H2Zm0 2h14v14H2V2Zm4 9H4v2h2v2h2v-2h2v-2h2V9h2V7h-2v2h-2v2H8v2H6v-2Z"/>
                    </svg>
                    <span class="filter-option__name">{{ option.name }}</span>
                    <span class="filter-option__count">{{ option.count }}</span>
                </label>
            </li>
            {% endfor %}
        </ul>
    </fieldset>
    {% endfor %}

    <button type="button" class="filter-panel__clear" data-filter-clear hidden>
        Clear filters
    </button>
</form>
