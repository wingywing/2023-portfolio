{#
    A single case study tile — the standard card, wrapped so the filter has
    something to match on.
    Pass through `study` — one entry from the caseStudies data file.

    The data-* attributes carry what the filter matches on, so filtering never
    has to parse the visible text. Nothing is hidden until the script runs.
#}
<li class="case-study-item"
    data-roles="{% for role in params.study.roles %}{{ role | roleSlug }}{% if not loop.last %} {% endif %}{% endfor %}"
    data-year="{{ params.study.date | year }}"
    data-search="{{ params.study.title }} {{ params.study.brief }} {{ params.study.client }} {{ params.study.type }} {{ params.study.roles | join(' ') }} {{ params.study.tools | join(' ') }}">
    {{
        component('card', {
            a: params.study.url,
            imgsrc: params.study.img,
            heading: params.study.title,
            caption: params.study.caption
        })
    }}
</li>
